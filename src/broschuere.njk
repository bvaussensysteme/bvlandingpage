{% for i in range(1, 37) %}{% set n = ("0" ~ i) if i < 10 else ("" ~ i) %}        <div class="bro-seite" data-density="{{ "hard" if i == 1 or i == 36 else "soft" }}" data-seite="{{ i }}">
          <img class="bro-bild" {% if i <= 2 %}src="/assets/broschuere/seite-{{ n }}.webp"{% endif %} data-src="/assets/broschuere/seite-{{ n }}.webp" width="1400" height="1966" alt="Broschüre, Seite {{ i }} von 36" />
        </div>
{% endfor %}      </div>
      </div>

