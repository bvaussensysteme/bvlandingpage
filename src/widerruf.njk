<script>
  // Datum-Feld mit heutigem Datum vorbelegen (rein optional, funktioniert auch ohne JS)
  (function () {
    var d = document.getElementById('wr-datum');
    if (d && !d.value) {
      var t = new Date();
      var p = function (n) { return (n < 10 ? '0' : '') + n; };
      d.value = p(t.getDate()) + '.' + p(t.getMonth() + 1) + '.' + t.getFullYear();
    }
  })();
</script>
