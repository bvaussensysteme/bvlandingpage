extraStyles: |
      .gebiet-hero {
        background: var(--black); padding: 56px 0 48px;
        border-bottom: 3px solid var(--gold); position: relative;
      }
      .gebiet-hero::after {
        content: ''; position: absolute; bottom: -1px; left: 0; width: 100%; height: 40px;
        background: var(--white); clip-path: polygon(0 100%, 100% 20%, 100% 100%);
      }
      .breadcrumb { font-size: 0.82rem; color: rgba(255,255,255,0.5); margin-bottom: 14px; }
      .breadcrumb a { color: var(--gold); text-decoration: none; }
      .gebiet-hero h1 { color: var(--white); margin-bottom: 10px; font-size: clamp(1.9rem,5vw,3rem); }
      .gebiet-hero p  { color: rgba(255,255,255,0.75); max-width: 560px; font-size: 0.97rem; line-height: 1.7; }

      /* Layout */
      .gebiet-layout {
        display: grid; grid-template-columns: 1fr 340px;
        gap: 32px; margin-top: 40px; align-items: start;
      }

      /* Karte */
      #map, #map-gate {
        height: 540px; border-radius: 12px;
        box-shadow: var(--shadow-lg);
        border: 2px solid var(--border);
        z-index: 0;
      }

      /* Karten-Platzhalter: Verbindung erst nach Klick */
      #map-gate {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        text-align: center; gap: 12px; padding: 24px; box-sizing: border-box;
        background: var(--off-white, #f5f5f3); color: var(--text, #222);
      }
      #map-gate p { margin: 0; max-width: 460px; font-size: 0.9rem; }
      #map-gate .kartegate-note { font-size: 0.8rem; color: var(--muted, #555); }
      #map-gate button {
        min-height: 44px; min-width: 44px; padding: 10px 24px; cursor: pointer;
        font: inherit; font-weight: 700; border: 0; border-radius: 8px;
        background: var(--gold, #C49A2A); color: #111;
      }
      #map-gate button:focus-visible { outline: 3px solid #111; outline-offset: 3px; }
      #map-gate[hidden] { display: none; }

      /* Ortsliste */
      .orte-panel {
        background: var(--white); border-radius: 12px;
        box-shadow: var(--shadow); border: 1px solid var(--border);
        overflow: hidden;
      }
      .orte-panel-header {
        background: var(--black); padding: 18px 20px;
        border-bottom: 3px solid var(--gold);
      }
      .orte-panel-header h3 {
        font-family: var(--schrift);
        font-size: 1.1rem; font-weight: 700; color: var(--white); margin: 0;
      }
      .orte-panel-header p { font-size: 0.78rem; color: rgba(255,255,255,0.55); margin-top: 3px; }
      .orte-list { list-style: none; padding: 8px 0; max-height: 460px; overflow-y: auto; }
      .orte-list li {
        padding: 0;
      }
      .orte-list button {
        width: 100%; text-align: left; background: none; border: none;
        padding: 11px 20px; cursor: pointer;
        display: flex; align-items: center; gap: 10px;
        font-family: var(--schrift); font-size: 0.9rem; color: var(--text);
        transition: background 0.15s; border-bottom: 1px solid var(--border);
      }
      .orte-list li:last-child button { border-bottom: none; }
      .orte-list button:hover { background: var(--offwhite); color: var(--gold-text); }
      .orte-list button.active { background: rgba(196,154,42,0.08); color: var(--gold-text); font-weight: 600; }
      .orte-dot {
        width: 10px; height: 10px; border-radius: 50%;
        background: var(--gold); flex-shrink: 0;
        box-shadow: 0 0 0 3px rgba(196,154,42,0.2);
      }
      .orte-dot.hauptort { background: var(--black); box-shadow: 0 0 0 3px rgba(196,154,42,0.4); }
      .orte-dot.fern { background: #fff; border: 2px solid var(--muted); box-shadow: none; }
      .info-badge {
        display: inline-flex; align-items: center; justify-content: center;
        width: 15px; height: 15px; border-radius: 50%; flex-shrink: 0;
        background: rgba(0,0,0,0.12); color: var(--muted);
        font-size: 0.65rem; font-style: italic; font-family: Georgia, 'Times New Roman', serif;
        margin-left: 2px; cursor: help;
      }
      .info-badge:hover, .info-badge:focus-visible { background: var(--gold); color: #fff; }
      #gebietTip {
        display: none; position: fixed; z-index: 1000;
        background: var(--black); color: #fff;
        font-family: var(--schrift); font-size: 0.76rem; font-style: normal;
        line-height: 1.5; padding: 9px 13px; border-radius: 8px;
        max-width: 230px; box-shadow: 0 6px 18px rgba(0,0,0,0.3);
      }

      /* Kartenpopup: Hintergrund kommt jetzt direkt vom Inhalt (inline
         style in bindPopup), da sich Leaflets eigener Wrapper-Hintergrund
         auf manchen Geräten nicht zuverlässig zeigte. Wrapper hier nur
         noch transparent/ohne eigenen Schatten, damit kein doppelter
         Kasten entsteht. */
      .bv-popup .leaflet-popup-content-wrapper {
        background: transparent;
        box-shadow: none;
        padding: 0;
      }
      .bv-popup .leaflet-popup-content { margin: 0; }
      .bv-popup .leaflet-popup-tip { background: #fff; }

      /* CTA unter Karte */
      .gebiet-cta {
        background: var(--black); border-radius: 12px;
        padding: 28px; text-align: center; margin-top: 24px;
        border: 1px solid rgba(196,154,42,0.25);
      }
      .gebiet-cta h3 { font-family: var(--schrift); font-size: 1.3rem; color: var(--white); margin-bottom: 8px; }
      .gebiet-cta p  { font-size: 0.85rem; color: rgba(255,255,255,0.6); margin-bottom: 16px; }


      @media (max-width: 860px) {
        .gebiet-layout { grid-template-columns: 1fr; }
        #map, #map-gate { height: 400px; }
        .orte-list { max-height: 300px; }
      }

extraScripts: |
  <script>
  /* Die Ortsliste stand hier als JavaScript-Literal. Seit dem
     19.11.2026 kommt sie aus src/_data/orte.json und steht als
     JSON-Block in der Seite; die sichtbare Liste wird daraus beim
     Bauen geschrieben. Zwei Kopien derselben Orte waeren sonst nur
     eine Frage der Zeit, bis eine davon veraltet. */
  var orte = JSON.parse(document.getElementById('orteDaten').textContent);

  // ── LEAFLET LAZY-LOADER (Muster wie in baugenehmigung.njk) ───
  // Bewusst erst nach Klick: Beim Laden von Leaflet und der Kacheln geht die
  // IP-Adresse an cdnjs.cloudflare.com und tile.openstreetmap.org.
  var gbLeafletLoaded = false;
  function gbLoadLeaflet(callback) {
    if (gbLeafletLoaded && window.L) { callback(); return; }
    var lcss = document.createElement('link');
    lcss.rel = 'stylesheet';
    lcss.href = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css';
    lcss.integrity = 'sha384-c6Rcwz4e4CITMbu/NBmnNS8yN2sC3cUElMEMfP3vqqKFp7GOYaaBBCqmaWBjmkjb';
    lcss.crossOrigin = 'anonymous';
    document.head.appendChild(lcss);
    var ljs = document.createElement('script');
    ljs.src = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js';
    ljs.integrity = 'sha384-NElt3Op+9NBMCYaef5HxeJmU4Xeard/Lku8ek6hoPTvYkQPh3zLIrJP7KiRocsxO';
    ljs.crossOrigin = 'anonymous';
    ljs.onload = function() { gbLeafletLoaded = true; callback(); };
    ljs.onerror = function() { callback(); }; // Karte überspringen bei Fehler
    document.head.appendChild(ljs);
  }

  // Karte erst nach Klick aufbauen. Die Ortsliste funktioniert auch ohne Karte.
  var map = null;
  var markers = [];
  var gbMapPending = null;

  function gbInitMap() {
    if (map || !window.L) return;
    document.getElementById('map-gate').hidden = true;
    var kasten = document.getElementById('map');
    kasten.hidden = false;
    /* Der Knopf, auf dem der Fokus lag, verschwindet mit dem
       Platzhalter. Ohne die naechsten zwei Zeilen faellt der Fokus auf
       <body> zurueck, und wer mit der Tastatur arbeitet, steht
       unvermittelt wieder am Seitenanfang, ohne Hinweis darauf, dass
       sich etwas getan hat. Gemessen am 14.11.2026, bevor es jemand
       benutzt hat. Der Kasten bekommt deshalb tabindex="-1", damit er
       Fokus annehmen kann, ohne in die Tab-Reihenfolge zu geraten. */
    kasten.setAttribute('tabindex', '-1');
    kasten.setAttribute('role', 'region');
    kasten.setAttribute('aria-label', 'Karte des Einzugsgebiets');
    kasten.focus({ preventScroll: true });
    map = L.map('map', { zoomControl: true }).setView([50.520, 7.800], 10);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 18
    }).addTo(map);

    var fernIcon = L.divIcon({
      className: 'orte-fern-marker',
      html: '<span style="display:block;width:14px;height:14px;border-radius:50%;background:#fff;border:3px solid #8a8a8a;"></span>',
      iconSize: [14, 14],
      iconAnchor: [7, 7]
    });
    orte.forEach(function(ort) {
      var marker = L.marker([ort.lat, ort.lng], ort.fern ? { icon: fernIcon } : {})
        .addTo(map)
        .bindPopup(
          '<div style="font-family:var(--schrift);min-width:160px;background:#ffffff;padding:12px 14px;border-radius:8px;box-shadow:0 3px 14px rgba(0,0,0,0.35);">' +
            '<strong style="font-family:var(--schrift);font-size:1rem;color:#111;">' + ort.name + '</strong><br>' +
            '<span style="font-size:0.82rem;color:#666;">' + ort.info + '</span><br>' +
            (ort.hinweis ? '<span style="font-size:0.78rem;color:#9A7318;">ℹ️ ' + ort.hinweis + '</span><br>' : '') +
            '<a href="/#kontakt" style="font-size:0.8rem;color:#9A7318;font-weight:600;text-decoration:none;">Jetzt anfragen →</a>' +
          '</div>',
          { maxWidth: 220, className: 'bv-popup' }
        );
      markers.push(marker);
    });
    if (gbMapPending !== null) {
      var p = gbMapPending; gbMapPending = null;
      map.setView([p.lat, p.lng], 13, { animate: true });
      markers[p.idx].openPopup();
    }
  }

  function gbMapLaden() {
    var gbtn = document.getElementById('map-gate-btn');
    gbtn.disabled = true;
    gbtn.textContent = 'Karte wird geladen …';
    gbLoadLeaflet(function() {
      if (window.L) { gbInitMap(); }
      else {
        gbtn.disabled = false;
        gbtn.textContent = 'Karte laden';
        gbtn.parentNode.querySelector('.kartegate-note').textContent =
          'Die Karte konnte nicht geladen werden. Die Ortsliste funktioniert weiterhin.';
      }
    });
  }
  document.getElementById('map-gate-btn').addEventListener('click', gbMapLaden);

  /* Die Liste steht schon da. Hier werden nur noch die Klicks
     angeschlossen. Vorher wurden die Eintraege hier erzeugt - siehe
     die Begruendung an der Liste im Seitentext. */
  var liste = document.getElementById('orteListe');
  liste.querySelectorAll('button[data-ort]').forEach(function(btn) {
    var idx = Number(btn.getAttribute('data-ort'));
    var ort = orte[idx];
    if (!ort) return;
    btn.addEventListener('click', function() {
      // Aktiven Button markieren
      liste.querySelectorAll('button').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      // Zur Position zoomen und Popup öffnen
      if (map) {
        map.setView([ort.lat, ort.lng], 13, { animate: true });
        markers[idx].openPopup();
      } else {
        // Karte noch nicht geladen: Auswahl merken, Karte erst auf Klick laden
        gbMapPending = { lat: ort.lat, lng: ort.lng, idx: idx };
        document.getElementById('map-gate-btn').focus();
      }
    });
  });

  // Marker-Gruppe für Referenz (kein automatisches fitBounds - wir bleiben bei Dernbach-Zoom)

  // Info-Tooltip für Randzone-Orte: fixed-positioniert (entkommt dem
  // overflow:hidden/auto der Liste), funktioniert per Klick (Mobil) und Hover (Desktop)
  var gebietTip = document.createElement('div');
  gebietTip.id = 'gebietTip';
  document.body.appendChild(gebietTip);

  function showGebietTip(badge) {
    var text = badge.getAttribute('data-tip');
    if (!text) return;
    gebietTip.textContent = text;
    gebietTip.style.display = 'block';
    var r = badge.getBoundingClientRect();
    var top = r.top - gebietTip.offsetHeight - 8;
    if (top < 8) top = r.bottom + 8;
    var left = r.left + r.width / 2 - gebietTip.offsetWidth / 2;
    left = Math.max(8, Math.min(left, window.innerWidth - gebietTip.offsetWidth - 8));
    gebietTip.style.top = top + 'px';
    gebietTip.style.left = left + 'px';
    gebietTip._openFor = badge;
  }
  function hideGebietTip() {
    gebietTip.style.display = 'none';
    gebietTip._openFor = null;
  }
  document.querySelectorAll('.info-badge').forEach(function(badge) {
    badge.addEventListener('mouseenter', function() { showGebietTip(badge); });
    badge.addEventListener('mouseleave', function() { hideGebietTip(); });
    badge.addEventListener('click', function(e) {
      e.stopPropagation();
      e.preventDefault();
      if (gebietTip._openFor === badge) { hideGebietTip(); }
      else { showGebietTip(badge); }
    });
  });
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.info-badge')) hideGebietTip();
  });
  document.addEventListener('scroll', hideGebietTip, true);
  </script>
---
<header class="gebiet-hero">
  <div class="container">
    <p class="breadcrumb"><a href="/">Startseite</a> › Einzugsgebiet</p>
    <p class="tag">Unser Einzugsgebiet</p>
    <h1>Wir kommen zu Ihnen.<br>Im Westerwald & Umgebung</h1>
    <p>Als regionaler Spezialist kennen wir die Gegend, die lokalen Bauvorschriften und
       die Wetterbedingungen im Westerwald. Unser Hauptstandort ist Dernbach, 
       wir sind in einem Umkreis von ca. <strong style="color:var(--gold)">60 km</strong> unterwegs.
       Bei größeren Aufträgen kommen wir auch weiter.</p>
  </div>
</header>

<main>
<section class="section">
  <div class="container">

    <div class="gebiet-layout">

      <!-- KARTE -->
      <div>
        <div id="map-gate">
          <p><strong>Karte nicht geladen.</strong> Die Karte wird erst auf Ihren Wunsch eingebunden.</p>
          <button type="button" id="map-gate-btn">Karte laden</button>
          <p class="kartegate-note">Beim Laden wird eine Verbindung zu OpenStreetMap aufgebaut. Dabei wird Ihre IP-Adresse übertragen.</p>
        </div>
        <div id="map" hidden></div>
        <div class="gebiet-cta">
          <h3>Ihr Standort nicht dabei?</h3>
          <p>Melden Sie sich trotzdem. Wir prüfen individuell ob wir zu Ihnen kommen können und suchen gemeinsam nach einer Lösung.</p>
          <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
            <a href="/#kontakt" class="btn btn-gold"><svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4z"/></svg> Anfrage starten</a>
            <a href="tel:+4915678696609" class="btn btn-dark" style="color:#fff !important;"><svg viewBox="0 0 24 24" aria-hidden="true" style="width:15px;height:15px;vertical-align:-2px;margin-right:5px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>0156 78696609</a>
          </div>
        </div>
      </div>

      <!-- ORTSLISTE -->
      <div class="orte-panel">
        <div class="orte-panel-header">
          <h3><svg viewBox="0 0 24 24" aria-hidden="true" style="width:18px;height:18px;vertical-align:-3px;margin-right:6px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>Unsere Regionen</h3>
          <p>Klicken zum Anzeigen auf der Karte · <span class="info-badge" style="margin-left:0;">i</span> = Rand unseres Gebiets, bitte anfragen</p>
        </div>
        {#- DIE ORTE STEHEN FEST IN DER SEITE, nicht erst nach dem
            Laden. Bis zum 19.11.2026 war dieses <ul> leer und wurde im
            Browser gefuellt; gemessen: ohne JavaScript 0 Eintraege,
            mit 31. Die Seite beantwortete ihre eigene Frage ("Kommt
            ihr zu mir?") also nur mit Skript.

            Die Daten liegen in src/_data/orte.json und werden an
            genau zwei Stellen benutzt: hier fuer die Liste und
            darunter als JSON fuer Karte und Klickverhalten. Eine
            Quelle, zwei Verwendungen. -#}
        <ul class="orte-list" id="orteListe">
        {%- for ort in orte %}
          <li><button type="button" data-ort="{{ loop.index0 }}"><span class="orte-dot{% if ort.hauptort %} hauptort{% endif %}{% if ort.fern %} fern{% endif %}"></span>{{ ort.name }}{% if ort.hinweis %} <span class="info-badge" data-tip="{{ ort.hinweis }}">i</span>{% endif %}</button></li>
        {%- endfor %}
        </ul>
        {#- Dieselben Daten fuer das Skript. Als JSON-Block und nicht
            als JavaScript-Literal: So steht die Liste nur einmal in
            der Seite und kann nicht auseinanderlaufen. -#}
        <script type="application/json" id="orteDaten">{{ orte | dump | safe }}</script>
      </div>

    </div>
  </div>
</section>
</main>
