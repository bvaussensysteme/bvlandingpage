ogType: "website"
extraStyles: |
      .partner-page { max-width: 860px; margin: 0 auto; }
      .partner-page h2 { margin-bottom: 12px; }
      .partner-page .page-intro {
        color: var(--muted); font-size: 1rem; line-height: 1.7;
        margin-bottom: 48px; max-width: 600px;
      }
      .partner-grid {
        display: grid;
        /* min(340px, 100%) statt 340px: Bei 320 px Bildschirmbreite
           erzwang die feste Zahl eine 340 px breite Spalte in einem
           292 px breiten Kasten. Gemessen am 22.11.2026: Die Karte
           reichte bis 332 px und war am rechten Rand abgeschnitten,
           ohne dass die Seite waagerecht scrollte, weil body
           overflow-x: hidden traegt. WCAG 2.2, 1.4.10.
           Ab 340 px aufwaerts aendert sich dadurch nichts. */
        grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
        gap: 24px;
      }
      .partner-card {
        /* min-width: 0 hebt die automatische Mindestbreite von
           Rasterfeldern auf. Ohne das kann der Inhalt die Spalte
           aufdruecken, egal was in grid-template-columns steht. */
        min-width: 0;
        background: var(--white);
        border-radius: 12px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
        padding: 32px 28px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        transition: box-shadow 0.2s, transform 0.2s;
      }
      .partner-card:hover {
        box-shadow: 0 8px 32px rgba(0,0,0,0.12);
        transform: translateY(-2px);
      }
      .partner-logo-wrap {
        background: var(--offwhite);
        border-radius: 10px;
        padding: 20px 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 4px;
      }
      .partner-logo-img {
        /* min(220px, 100%) statt 220px: Zusammen mit dem Innenabstand
           des Kastens (2 x 28 px) und der Karte (2 x 20 px) ergab die
           feste Zahl eine Mindestbreite von 318 px. Ein Rasterfeld
           waechst auf die Mindestbreite seines Inhalts, deshalb war die
           Karte bei 320 px Bildschirm 318 px breit in einer 292 px
           breiten Spalte und ragte rechts heraus. Gemessen am
           22.11.2026, WCAG 2.2, 1.4.10. */
        max-width: min(220px, 100%);
        max-height: 60px;
        width: auto;
        height: auto;
        object-fit: contain;
      }
      .partner-card-header {
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .partner-icon {
        width: 52px; height: 52px;
        background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.6rem;
        flex-shrink: 0;
      }
      .partner-name {
        font-family: var(--schrift);
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--black);
        line-height: 1.2;
      }
      .partner-category {
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--gold-text);
        margin-top: 2px;
      }
      .partner-divider {
        height: 2px;
        background: linear-gradient(90deg, var(--gold) 0%, transparent 100%);
        border-radius: 1px;
        opacity: 0.4;
      }
      .partner-description {
        font-size: 0.91rem;
        color: var(--muted);
        line-height: 1.65;
      }
      .partner-link {
        display: inline-flex;
        align-items: center;
        /* Gemessen am 22.11.2026: 23 px hoch, also 1 px unter der
           Projektgrenze von 24 x 24 px (WCAG 2.2, 2.5.8). Ein Verweis
           als eigene Zeile am Kartenende faellt nicht unter die
           Ausnahme fuer Verweise im Fliesstext. 2 px Innenabstand oben
           und unten, damit sich an der Gestaltung nichts aendert. */
        padding-block: 2px;
        gap: 7px;
        color: var(--gold-text);
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.2s;
        margin-top: auto;
      }
      .partner-link:hover { color: var(--gold); }
      .partner-link svg {
        width: 14px; height: 14px;
        stroke: currentColor; fill: none;
        stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
      }
      @media (max-width: 600px) {
        .partner-grid { grid-template-columns: 1fr; }
        .partner-card { padding: 24px 20px; }
      }

