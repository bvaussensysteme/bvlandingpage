<style>
  .stoffe-intro { max-width:760px; }
  .stoff-block-h { position:relative; padding-top:20px; margin:44px 0 20px; }
  .stoff-block-h::before { content:""; position:absolute; top:0; left:0; width:56px; height:4px; background:var(--gold); border-radius:2px; }
  .stoff-block-h h2 { margin:0; }
  .stoff-block-sub { color:var(--muted); font-size:.92rem; margin:4px 0 0; }

  /* AC/PA – große Zeilen: Label | flaches Muster | Markisen-Ansicht */
  .stoff-row { display:grid; grid-template-columns:200px 1fr 1fr; gap:26px; align-items:center; padding:26px 0; border-bottom:1px solid var(--border); }
  .stoff-dessin { font-size:1.05rem; font-weight:600; margin:0 0 14px; }
  .stoff-props { display:flex; gap:8px; }
  .stoff-props .ic { position:relative; width:48px; height:48px; border:1.5px solid var(--dark); border-radius:8px; display:flex; align-items:center; justify-content:center; color:var(--dark); }
  .stoff-props .ic .burst { position:absolute; inset:6px; width:auto; height:auto; }
  .stoff-props .ic b { position:relative; font-weight:700; font-size:.66rem; letter-spacing:.01em; background:#fff; padding:0 1px; }
  .stoff-flat { width:100%; height:auto; display:block; border-radius:8px; border:1px solid var(--border); }
  .stoff-flat.span2 { grid-column:2 / -1; }
  .stoff-markise-img { width:100%; height:auto; display:block; }

  /* T-Serie – 2-spaltiges Raster */
  .zip-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:30px 44px; margin-top:8px; }
  .zip-title { margin:0 0 10px; font-size:1rem; }
  .zip-code { font-weight:700; }
  .zip-name { color:var(--muted); }
  .zip-item img { width:100%; height:auto; display:block; border-radius:6px; border:1px solid var(--border); }
  .zip-konf { display:flex; justify-content:space-between; font-size:.82rem; color:var(--muted); padding:10px 2px 0; border-bottom:1px solid var(--border); }

  .stoffe-note { background:var(--light-bg); border-radius:var(--radius); padding:16px 18px; font-size:.88rem; color:var(--muted); margin-top:40px; display:flex; gap:14px; align-items:center; flex-wrap:wrap; }
  .stoffe-note img { height:28px; width:auto; }

  @media (max-width:820px) {
    .stoff-row { grid-template-columns:1fr 1fr; }
    .stoff-meta { grid-column:1 / -1; }
    .stoff-flat.span2 { grid-column:1 / -1; }
  }
  @media (max-width:560px) {
    .stoff-row { grid-template-columns:1fr; gap:16px; }
    .zip-grid { grid-template-columns:1fr; gap:24px; }
  }
</style>

