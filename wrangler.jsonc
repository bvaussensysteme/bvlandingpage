{
  "name": "bvlanding",
  "compatibility_date": "2026-07-04",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Für diese alten URLs muss der Worker vor der statischen Datei laufen,
    // damit die 301-Weiterleitung in worker/index.js (REDIRECTS) greift.
    // Ohne run_worker_first liefert Cloudflare die passende .html-Datei
    // direkt aus und der Worker-Code wird nie aufgerufen.
    "run_worker_first": [
      "/produkte/balkonueberdachung.html",
      "/produkte/sonnenschutz-beschattung.html",
      "/termin.html",
      "/kontakt.html",
      // Werkstatt: MUSS hier stehen. Ohne diesen Eintrag liefert
      // Cloudflare werkstatt/index.html direkt als Datei aus, ohne den
      // Worker zu fragen - die Passwortschranke wuerde nie aufgerufen
      // und die Seite laege offen. Geprueft von scripts/pruefe-werkstatt.js.
      "/werkstatt",
      "/werkstatt/*"
    ]
  },
  // Die VD-Matrix liegt bewusst NICHT in diesem oeffentlichen Repository,
  // sondern im KV-Speicher. Das Binding fehlt hier absichtlich, solange der
  // Namensraum nicht angelegt ist - eine erfundene id wuerde jeden Deploy
  // scheitern lassen. Anlegen und eintragen: siehe worker/index.js.
  // Danach hier ergaenzen:
  //   "kv_namespaces": [{ "binding": "DACHMATRIX", "id": "<id>" }],
  // Ohne Binding antwortet /api/bauteile mit 503 und der Konfigurator zeigt
  // die geschaetzte Skizze - die Seite bleibt benutzbar.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
