{
  "name": "bvlanding",
  "compatibility_date": "2026-07-04",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Für diese alten URLs muss der Worker vor der statischen Datei laufen,
    // damit die 301-Weiterleitung in worker/index.js (REDIRECTS) greift.
    // Ohne run_worker_first liefert Cloudflare die passende .html-Datei
    // direkt aus und der Worker-Code wird nie aufgerufen.
    "run_worker_first": [
      "/produkte/balkonueberdachung.html",
      "/produkte/sonnenschutz-beschattung.html",
      "/termin.html",
      "/kontakt.html"
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
